# Example environment variables for rag-chatbot.
# Copy this file to `.env` and adjust values for your local setup.
# `.env` is ignored by git; do not commit secrets.

# Logging
LOG_LEVEL=INFO

# SQLite question job store
QUESTIONS_DB_PATH=data/questions.db
QUESTIONS_ARCHIVE_DIR=data/question_archives
QUESTIONS_BACKUP_DIR=data/question_backups
QUESTIONS_LIVE_RETENTION_DAYS=30
QUESTIONS_ARCHIVE_RETENTION_DAYS=365

# Postgres/pgvector connection (used once retrieval is wired up).
# POSTGRES_HOST=localhost applies to local non-Compose runs. The Compose app
# service always sets POSTGRES_HOST=postgres so it can reach the vector-db
# profile service; that override is not read from this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab
POSTGRES_DB=raglab

# Model adapters
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_PROVIDER=local
GENERATION_MODEL=stub
# Per-request client timeout in seconds. The OpenAI SDK is created with
# max_retries=0. GENERATION_MAX_RETRIES is the number of extra application
# attempts for rate limits, selected 5xx responses, and transport failures.
# Those retries call the provider again and can bill another generation.
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_RETRIES=2
# Optional completion-token cap. Leave commented to omit an explicit cap.
# GENERATION_MAX_OUTPUT_TOKENS=1024
# Optional instructions sent separately from the question. Leave commented for none.
# GENERATION_INSTRUCTIONS=Answer concisely.

# Optional OpenAI provider configuration. Uncomment and replace the value when
# GENERATION_PROVIDER=openai; leave commented to keep local startup key-free.
# OPENAI_API_KEY=replace-with-your-key

# Optional real-provider smoke test configuration. Also set
# RUN_OPENAI_SMOKE=1 when invoking pytest; this model may incur API usage.
# OPENAI_SMOKE_MODEL=your-enabled-model
