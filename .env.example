# Example environment variables for rag-chatbot.
# Copy this file to `.env` and adjust values for your local setup.
# `.env` is ignored by git; do not commit secrets.

# Logging
LOG_LEVEL=INFO

# SQLite question job store
QUESTIONS_DB_PATH=data/questions.db

# Postgres/pgvector connection (used once retrieval is wired up)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab
POSTGRES_DB=raglab

# Model adapters
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_PROVIDER=local
GENERATION_MODEL=stub

# Optional OpenAI provider configuration. Uncomment and replace the value when
# GENERATION_PROVIDER=openai; leave commented to keep local startup key-free.
# OPENAI_API_KEY=replace-with-your-key

# Optional real-provider smoke test configuration. Also set
# RUN_OPENAI_SMOKE=1 when invoking pytest; this model may incur API usage.
# OPENAI_SMOKE_MODEL=your-enabled-model
